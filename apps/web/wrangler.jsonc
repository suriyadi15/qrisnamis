{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrisnamis",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": { "enabled": false }
}
