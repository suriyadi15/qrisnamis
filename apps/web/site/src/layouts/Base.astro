---
import '../styles.css'
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; jsonLd?: Record<string, unknown> }
const {
  title = 'qrisnamis — QRIS statis jadi dinamis',
  description = 'Library TypeScript, API, dan generator gratis untuk mengubah QRIS statis menjadi QRIS dinamis dengan nominal tertanam.',
  image = '/og.png',
  noindex = false,
  jsonLd,
} = Astro.props
// Cloudflare Pages serves /docs (no trailing slash); keep canonical in sync with sitemap.xml
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site)
const imageUrl = new URL(image, Astro.site)
const navLinks = [
  { href: '/#generator', label: 'Generator' },
  { href: '/docs', label: 'Docs' },
  { href: '/api/docs', label: 'API Playground' },
  { href: '/legal', label: 'Legal' },
  { href: '/#traktir', label: 'Traktir' },
]
const imageAlt = 'qrisnamis — ubah QRIS statis menjadi dinamis dengan nominal tertanam'
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="qris, qris dinamis, qris statis, qris nominal, generator qris, api qris, typescript, emvco" />
    <meta name="author" content="Suriyadi" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="qrisnamis" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="border-b border-slate-200">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 text-sm">
        <a href="/" class="font-bold text-ink">▦ qrisnamis</a>
        <div class="flex items-center gap-4">
          <div class="hidden items-center gap-4 sm:flex">
            {navLinks.map((l) => <a href={l.href} class="hover:text-brand">{l.label}</a>)}
          </div>
          <a href="https://github.com/suriyadi15/qrisnamis" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-brand" aria-label="GitHub"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span class="hidden sm:inline">GitHub</span></a>
          <details id="nav-menu" class="relative sm:hidden">
            <summary class="flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded-md hover:bg-slate-100 [&::-webkit-details-marker]:hidden" aria-label="Menu">
              <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
            </summary>
            <div class="absolute right-0 z-10 mt-2 flex w-48 flex-col rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
              {navLinks.map((l) => <a href={l.href} class="px-4 py-2 hover:bg-slate-50 hover:text-brand">{l.label}</a>)}
            </div>
          </details>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="mt-16 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-5xl space-y-2 px-4 py-6 text-xs text-slate-500">
        <p>
          Proyek open source berlisensi MIT. <strong>Tidak berafiliasi</strong> dengan Bank Indonesia, ASPI, penyedia jasa pembayaran, maupun acquirer mana pun.
          "QRIS" adalah merek milik pemiliknya. Perangkat lunak disediakan "apa adanya" tanpa jaminan; pengguna bertanggung jawab penuh atas penggunaannya.
        </p>
        <p>
          <a class="underline" href="/legal">Syarat Penggunaan, Privasi &amp; Disclaimer</a> ·
          <a class="inline-flex items-center gap-1 underline" href="https://github.com/suriyadi15/qrisnamis" target="_blank" rel="noopener"><svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>GitHub</a> ·
          <a class="underline" href="https://qrishook.pages.dev/" target="_blank" rel="noopener">QRIS Hook</a> ·
          <a class="underline" href="https://trakteer.id/suriyadi15/tip" target="_blank" rel="noopener">Traktir</a>
        </p>
      </div>
    </footer>
    <script>
      const menu = document.getElementById('nav-menu') as HTMLDetailsElement | null
      menu?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) menu.open = false })
      document.addEventListener('click', (e) => { if (menu?.open && !menu.contains(e.target as Node)) menu.open = false })
    </script>
  </body>
</html>
